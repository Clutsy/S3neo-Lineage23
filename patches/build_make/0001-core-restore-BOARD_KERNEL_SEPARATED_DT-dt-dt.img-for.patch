From dee722c83bf83b3dd661c6a07eb5d7b63b1c7c5c Mon Sep 17 00:00:00 2001
From: ci <ci@local>
Date: Sat, 3 Oct 2026 07:08:51 +0000
Subject: [PATCH] core: restore BOARD_KERNEL_SEPARATED_DT (--dt dt.img) for
 boot and recovery images (lineage-21.0 behaviour)

---
 core/Makefile | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/core/Makefile b/core/Makefile
index b8c4189..cb9ad69 100644
--- a/core/Makefile
+++ b/core/Makefile
@@ -1354,6 +1354,13 @@ else ifndef BUILDING_VENDOR_BOOT_IMAGE # && BOARD_USES_GENERIC_KERNEL_IMAGE != t
   endif
 endif # BUILDING_VENDOR_BOOT_IMAGE == "" && BOARD_USES_GENERIC_KERNEL_IMAGE != true
 
+# Qualcomm separate device tree image (dt.img), as in lineage-21.0.
+# The msm8226 bootloader needs mkbootimg --dt; dt.img is produced by vendor/lineage build/tasks/dt_image.mk.
+ifeq ($(strip $(BOARD_KERNEL_SEPARATED_DT)),true)
+  INSTALLED_DTIMAGE_TARGET := $(PRODUCT_OUT)/dt.img
+  INTERNAL_BOOTIMAGE_ARGS += --dt $(INSTALLED_DTIMAGE_TARGET)
+endif
+
 # Define these only if we are building boot
 ifdef BUILDING_BOOT_IMAGE
 INSTALLED_BOOTIMAGE_TARGET := $(BUILT_BOOTIMAGE_TARGET)
@@ -2756,6 +2763,11 @@ ifndef BOARD_RECOVERY_MKBOOTIMG_ARGS
   BOARD_RECOVERY_MKBOOTIMG_ARGS := $(BOARD_MKBOOTIMG_ARGS)
 endif
 
+ifeq ($(strip $(BOARD_KERNEL_SEPARATED_DT)),true)
+  INTERNAL_RECOVERYIMAGE_ARGS += --dt $(INSTALLED_DTIMAGE_TARGET)
+  INTERNAL_RECOVERYIMAGE_FILES += $(INSTALLED_DTIMAGE_TARGET)
+endif
+
 $(INTERNAL_RECOVERY_RAMDISK_FILES_TIMESTAMP): $(MKBOOTFS) \
 	    $(INTERNAL_ROOT_FILES) \
 	    $(INSTALLED_RAMDISK_TARGET) \
-- 
2.43.0

