<?xml version="1.0" encoding="UTF-8"?>
<!-- Galaxy S3 Neo (s3ve3g*) on LineageOS 23.2 (Android 16 QPR2).
     Pins are BEST EFFORT and unverified: 'analyze' mode in the workflow exists to find what breaks.
     Device/kernel trees: html6405 lineage-21.0 (newest public). Support repos: newest branch that exists. -->
<manifest>
  <remote name="html6405" fetch="https://github.com/html6405" />

  <!-- Device + kernel (Android 14-era, to be ported) -->
  <project path="device/samsung/msm8226-common" name="android_device_samsung_msm8226-common" remote="html6405" revision="lineage-21.0" />
  <project path="device/samsung/s3ve3g-common"  name="android_device_samsung_s3ve3g-common"  remote="html6405" revision="lineage-21.0" />
  <project path="device/samsung/s3ve3gxx"       name="android_device_samsung_s3ve3gxx"       remote="html6405" revision="lineage-20.0" />
  <project path="device/samsung/s3ve3gjv"       name="android_device_samsung_s3ve3gjv"       remote="html6405" revision="lineage-20.0" />
  <project path="kernel/samsung/msm8226"        name="android_kernel_samsung_msm8226"        remote="html6405" revision="lineage-21.0-BPF" />

  <!-- Dependencies from lineage.dependencies. qcom-common has no 23.x branch (last: lineage-22.2). -->
  <project path="device/samsung/qcom-common" name="LineageOS/android_device_samsung_qcom-common" revision="lineage-22.2" />
  <project path="hardware/sony/timekeep"     name="LineageOS/android_hardware_sony_timekeep"     revision="lineage-23.2" />

  <!-- Legacy qcom HALs: LOS 21.0 default.xml carries them, 23.2 default.xml only keeps hardware/qcom/wlan.
       Newest plain (non-caf) branch that exists on GitHub for each:
       audio 23.2, display 22.2, media 22.2, gps 23.0, camera 22.2, bt 23.0. -->
  <project path="hardware/qcom/audio"   name="LineageOS/android_hardware_qcom_audio"   revision="lineage-23.2" />
  <project path="hardware/qcom/display" name="LineageOS/android_hardware_qcom_display" revision="lineage-22.2" />
  <project path="hardware/qcom/media"   name="LineageOS/android_hardware_qcom_media"   revision="lineage-22.2" />
  <project path="hardware/qcom/gps"     name="LineageOS/android_hardware_qcom_gps"     revision="lineage-23.0" />
  <project path="hardware/qcom/camera"  name="LineageOS/android_hardware_qcom_camera"  revision="lineage-22.2" />
  <project path="hardware/qcom/bt"      name="LineageOS/android_hardware_qcom_bt"      revision="lineage-23.0" />

  <!-- msm8226-common sepolicy.mk includes device/qcom/sepolicy-legacy/sepolicy.mk.
       Last branch with a plain "-legacy" policy is lineage-18.1-legacy (very old: expect SELinux work). -->
  <project path="device/qcom/sepolicy-legacy" name="LineageOS/android_device_qcom_sepolicy" revision="lineage-18.1-legacy" />

  <!-- Kernel 3.4 needs GCC 4.9; LOS 23.2 no longer ships it (verified: default.xml has only host gcc). -->
  <project path="prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9"
           name="LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9" revision="lineage-19.1" clone-depth="1" />

  <!-- Found by static pass 2 (verified in sources on 2026-10-03):
       - hardware/samsung is not in the 23.2 default.xml (qcom-common lists it as a dependency); branch lineage-23.2 exists.
         Its mkbootimg.mk was removed in 23.2 (last present: lineage-23.0), hence the board-config patch.
       - dtbToolLineage (host tool used by vendor/lineage dt_image.mk) is in no 21.0/23.2 manifest; source repo newest branch: lineage-18.1.
       - 21.0 used LineageOS' mkbootimg fork (it supports the dt-image option); 23.2 uses plain AOSP mkbootimg (no dt-image option). The fork has no 23.2 branch:
         lineage-21.0 is pinned as an override. It may be too old for Android 16 releasetools: watch the analyze/build logs. -->
  <project path="hardware/samsung" name="LineageOS/android_hardware_samsung" revision="lineage-23.2" />
  <project path="system/tools/dtbtool" name="LineageOS/android_system_tools_dtbtool" revision="lineage-18.1" />
  <remove-project name="platform/system/tools/mkbootimg" />
  <project path="system/tools/mkbootimg" name="LineageOS/android_system_tools_mkbootimg" revision="lineage-21.0" />

  <!-- Vendor blobs are not a manifest project: scripts/fetch_blobs.sh copies them from TheMuppets lineage-18.1. -->
</manifest>
